{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "scaleshift",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference binding; the service name must match the worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "scaleshift" }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "scaleshift.uk", "custom_domain": true },
    { "pattern": "www.scaleshift.uk", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
